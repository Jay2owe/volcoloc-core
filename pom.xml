	<name>volcoloc-core</name>
	<description>Volumetric colocalization engine, as an embeddable module. Never shipped as a jar.</description>
	<url>https://github.com/Jay2owe/VolumetricColocalization</url>
	<inceptionYear>2026</inceptionYear>

