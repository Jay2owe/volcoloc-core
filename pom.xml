		<contributor>
			<name>Jamie Malcolm</name>
			<url>https://github.com/Jay2owe</url>
			<properties><id>Jay2owe</id></properties>
		</contributor>
	</contributors>
	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imagej</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/Jay2owe/VolumetricColocalization</connection>
		<developerConnection>scm:git:git@github.com:Jay2owe/VolumetricColocalization</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/Jay2owe/VolumetricColocalization</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Jay2owe/VolumetricColocalization/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/Jay2owe/VolumetricColocalization/actions</url>
	</ciManagement>

	<properties>
		<package-name>sc.fiji.volcoloc.core</package-name>
		<license.licenseName>bsd_3</license.licenseName>
		<license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
		<!-- No main class: this module is a library, never a plugin. -->
		<enforcer.skip>true</enforcer.skip>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		  The entire dependency list.

		  The module spec says this core depends on oc3d-core and links
		  net.imagej:ij "via oc3d-core". That mechanism does not work: oc3d-core
		  declares ij at `provided` scope, and provided scope is not transitive,
		  so nothing would be on this module's compile classpath. ij is therefore
		  declared here directly, at the same scope and the same managed version
		  the Volumetric Colocalization plugin resolves.

		  oc3d-core itself is deliberately NOT declared. The extracted engine
		  reads label stacks directly and calls nothing in the chassis today, and
		  an unused dependency would be shaded into every consumer as dead code.
		  It becomes load-bearing at migration Stage 1, when the plugin's ingest
		  and IO are reconciled against oc3d-core; add it in that change, not
		  before. See DECISIONS.md.
		-->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>false</addClasspath>
						</manifest>
						<manifestEntries>
							<Automatic-Module-Name>io.github.jay2owe.volcoloc.core</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
				<!--
				  The equivalence harness runs this engine from the plugin's own
				  test tree against the plugin's pre-extraction engine, so the
				  shared fixtures in src/test are published too.
				-->
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
